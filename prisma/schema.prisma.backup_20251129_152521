// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chain {
  id                     Int      @id @default(autoincrement())
  chainId                Int      @unique
  name                   String
  network                String
  rpcUrl                 String
  blockExplorer          String
  nativeCurrencyName     String
  nativeCurrencySymbol   String
  nativeCurrencyDecimals Int
  isTestnet              Boolean  @default(false)
  icon                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  factories  LaunchpadFactory[]
  launchpads Launchpad[]
  activities Activity[]

  @@map("chains")
}

model LaunchpadFactory {
  id                    String    @id @default(cuid())
  chainId               Int
  contractAddress       String    @unique
  version               String
  deployedChainId       Int
  owner                 String
  treasury              String
  creationFee           String
  platformFeePercentage Int
  freeMintFee           String
  totalLaunchpads       Int       @default(0)
  isActive              Boolean   @default(true)
  deployedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  chain      Chain            @relation(fields: [chainId], references: [chainId])
  launchpads Launchpad[]
  activities Activity[]
  settings   FactorySetting[]

  @@map("launchpad_factories")
}

model Launchpad {
  id                String          @id @default(cuid())
  chainId           Int
  factoryId         String
  contractAddress   String          @unique
  creator           String
  name              String
  symbol            String
  description       String?
  baseURI           String?
  unrevealedURI     String?
  contractURI       String?
  externalLink      String?
  totalMaxSupply    Int
  mintedCount       Int             @default(0)
  treasury          String
  royaltyRecipient  String?
  royaltyPercentage Int             @default(0)
  status            LaunchpadStatus @default(ACTIVE)
  volume            String          @default("0")
  lastMintAt        DateTime?
  lastSyncAt        DateTime        @default(now())
  deployTxHash      String?
  manifestHash      String?         // IPFS hash of manifest JSON for individual file mapping
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  chain      Chain                @relation(fields: [chainId], references: [chainId])
  factory    LaunchpadFactory     @relation(fields: [factoryId], references: [id])
  mints      Mint[]
  phases     LaunchpadPhase[]
  metadata   LaunchpadMetadata?
  analytics  LaunchpadAnalytics?
  whitelists LaunchpadWhitelist[]
  banners    Banner[]

  // Indexes for performance optimization
  @@index([creator])
  @@index([chainId, creator])
  @@index([createdAt])
  @@index([chainId, createdAt])
  @@map("launchpads")
}

model LaunchpadPhase {
  id               String    @id @default(cuid())
  launchpadId      String
  name             String
  phaseType        PhaseType
  startTime        DateTime
  endTime          DateTime?
  price            String
  maxMintPerWallet Int?
  totalLimit       Int?
  mintedCount      Int       @default(0)
  isActive         Boolean   @default(true)
  merkleRoot       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  launchpad Launchpad @relation(fields: [launchpadId], references: [id], onDelete: Cascade)
  mints     Mint[]

  @@map("launchpad_phases")
}

model LaunchpadWhitelist {
  id          String   @id @default(cuid())
  launchpadId String
  phaseId     Int
  address     String
  allocation  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  launchpad Launchpad @relation(fields: [launchpadId], references: [id], onDelete: Cascade)

  @@unique([launchpadId, phaseId, address])
  @@index([launchpadId, phaseId])
  @@map("launchpad_whitelists")
}

model Mint {
  id          String   @id @default(cuid())
  launchpadId String
  phaseId     String?
  minter      String
  tokenId     Int?
  quantity    Int      @default(1)
  price       String
  txHash      String   @unique
  blockNumber Int?
  gasUsed     String?
  createdAt   DateTime @default(now())

  // Relations
  launchpad Launchpad       @relation(fields: [launchpadId], references: [id], onDelete: Cascade)
  phase     LaunchpadPhase? @relation(fields: [phaseId], references: [id])

  @@map("mints")
}

model LaunchpadMetadata {
  id          String   @id @default(cuid())
  launchpadId String   @unique
  image       String?
  bannerImage String?
  website     String?
  twitter     String?
  discord     String?
  telegram    String?
  medium      String?
  github      String?
  tags        String[]
  category    String?
  featured    Boolean  @default(false)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  launchpad Launchpad @relation(fields: [launchpadId], references: [id], onDelete: Cascade)

  @@map("launchpad_metadata")
}

model LaunchpadAnalytics {
  id            String   @id @default(cuid())
  launchpadId   String   @unique
  totalVolume   String   @default("0")
  totalMints    Int      @default(0)
  uniqueHolders Int      @default(0)
  avgMintPrice  String   @default("0")
  floorPrice    String?
  lastSalePrice String?
  views         Int      @default(0)
  likes         Int      @default(0)
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  launchpad Launchpad @relation(fields: [launchpadId], references: [id], onDelete: Cascade)

  @@map("launchpad_analytics")
}

model Activity {
  id          String       @id @default(cuid())
  chainId     Int
  factoryId   String?
  launchpadId String?
  type        ActivityType
  actor       String
  description String
  txHash      String?
  blockNumber Int?
  metadata    Json?
  createdAt   DateTime     @default(now())

  // Relations
  chain   Chain             @relation(fields: [chainId], references: [chainId])
  factory LaunchpadFactory? @relation(fields: [factoryId], references: [id])

  // Indexes for performance optimization
  @@index([chainId, type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("activities")
}

model FactorySetting {
  id        String      @id @default(cuid())
  factoryId String
  key       String
  value     String
  type      SettingType @default(STRING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  factory LaunchpadFactory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@unique([factoryId, key])
  @@map("factory_settings")
}

model BulkOperation {
  id          String            @id @default(cuid())
  name        String
  type        BulkOperationType
  status      BulkStatus        @default(PENDING)
  progress    Int               @default(0)
  total       Int
  processed   Int               @default(0)
  errors      Json[]            @default([])
  data        Json
  result      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("bulk_operations")
}

model AdminUser {
  id           String    @id @default(cuid())
  address      String    @unique
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model Banner {
  id                String       @id @default(cuid())
  title             String
  creator           String
  network           String       @default("evm")
  image             String
  thumbnail         String?
  type              BannerType   @default(IMAGE)
  twitter           String?
  discord           String?
  telegram          String?
  collectionAddress String?
  launchpadId       String?
  mintedDate        DateTime?
  mintedLink        String?
  status            BannerStatus @default(ACTIVE)
  sequence          Int          @default(0)
  startDate         DateTime?
  endDate           DateTime?
  promoCode         String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  launchpad Launchpad? @relation(fields: [launchpadId], references: [id], onDelete: SetNull)

  @@index([status, sequence])
  @@index([startDate, endDate])
  @@map("banners")
}

model PromoRequest {
  id                String            @id @default(cuid())
  promoCode         String            @unique
  collectionName    String
  collectionAddress String?
  creator           String
  chainId           Int
  chainName         String
  image             String?
  thumbnail         String?
  twitter           String?
  discord           String?
  telegram          String?
  description       String?
  status            PromoRequestStatus @default(PENDING)
  rejectionReason   String?
  bannerId          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, createdAt])
  @@map("promo_requests")
}

// Enums
enum LaunchpadStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PhaseType {
  PRESALE
  PUBLIC
  ALLOWLIST
  FREE
}

enum ActivityType {
  FACTORY_CREATED
  LAUNCHPAD_CREATED
  LAUNCHPAD_UPDATED
  MINT_OCCURRED
  PHASE_CREATED
  PHASE_UPDATED
  FEE_UPDATED
  TREASURY_UPDATED
  OWNERSHIP_TRANSFERRED
  EMERGENCY_WITHDRAW
  BURN_OCCURRED
  AIRDROP_OCCURRED
  COLLECTION_REVEALED
  ROYALTY_UPDATED
  METADATA_UPDATED
  CONTRACT_PAUSED
  CONTRACT_UNPAUSED
  TRANSFER_LOCK_UPDATED
  ROLE_GRANTED
  ROLE_REVOKED
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum BulkOperationType {
  CREATE_LAUNCHPADS
  UPDATE_FEES
  UPDATE_TREASURIES
  EXPORT_DATA
}

enum BulkStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  VIEWER
}

enum BannerType {
  IMAGE
  VIDEO
}

enum BannerStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
}

enum PromoRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
