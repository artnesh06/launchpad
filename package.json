{
  "name": "next-shadcn-dashboard-starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Kiran",
    "url": "https://github.com/Kiranism"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=1000000000' next dev --turbo",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:banners": "node prisma/seed-banners.js",
    "db:studio": "prisma studio",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "format": "prettier --write .",
    "format:check": "prettier -c -w .",
    "sync:all": "tsx scripts/sync-all-launchpads.ts",
    "sync:nft-images": "tsx scripts/sync-nft-images.ts",
    "health": "curl http://localhost:3000/api/health",
    "test:alchemy": "tsx scripts/test-alchemy-service.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ]
  },
